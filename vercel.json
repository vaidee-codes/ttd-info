{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/PRIVACY_POLICY"
    },
    {
      "source": "/privacy-policy",
      "destination": "/PRIVACY_POLICY"
    },
    {
      "source": "/privacy-notice",
      "destination": "/PRIVACY_POLICY"
    },
    {
      "source": "/shipping",
      "destination": "/shipping-policy"
    },
    {
      "source": "/delivery",
      "destination": "/shipping-policy"
    },
    {
      "source": "/delivery-policy",
      "destination": "/shipping-policy"
    },
    {
      "source": "/shipping-and-delivery",
      "destination": "/shipping-policy"
    },
    {
      "source": "/contact-us",
      "destination": "/contact"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms"
    },
    {
      "source": "/refunds",
      "destination": "/refund-policy"
    },
    {
      "source": "/cancellation-policy",
      "destination": "/refund-policy"
    },
    {
      "source": "/refund-and-cancellation",
      "destination": "/refund-policy"
    }
  ],
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/license-activate.mjs": {
      "maxDuration": 30
    },
    "api/payment-confirm.mjs": {
      "maxDuration": 30
    },
    "api/razorpay-webhook.mjs": {
      "maxDuration": 30
    },
    "api/payments-reconcile.mjs": {
      "maxDuration": 60
    },
    "api/health-watch.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.razorpay.com; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://player.vimeo.com https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/ops/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/payments-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/health-watch",
      "schedule": "*/5 * * * *"
    }
  ]
}
